# Public base URL of the deployed site (used for SEO canonical/OG metadata).
NEXT_PUBLIC_SITE_URL=https://hiago.sh

# Field notes subscriptions -> Google Sheets.
# Share the spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as editor.
GOOGLE_SHEETS_SPREADSHEET_ID=1D4Hx5J0eiU9qKkh6GLHc0G3Na5rJtl5tA7t1Za3vQ5w
GOOGLE_SHEETS_RANGE=A:C
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Alternative: paste the full Google service account JSON here instead of the
# two fields above.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Dino game top 10 ranking -> Supabase (PostgREST via publishable key).
# Create the table with supabase/migrations/20260731120000_dino_scores.sql.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. When set, inserts use the service role (RLS-bypass)
# and the anon insert policy can be dropped (see hardening migration).
SUPABASE_SERVICE_ROLE_KEY=
# Pepper used to hash caller IPs for the flagged-score audit trail.
DINO_IP_PEPPER=
